# /etc/systemd/system/pg-backup.service
# Executa o backup uma vez; quem agenda é o pg-backup.timer.
[Unit]
Description=Backup logico do PostgreSQL em container
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/pg-backup
ExecStart=/usr/local/bin/backup-postgres-docker.sh
# Usuário dedicado, membro do grupo docker, dono de /var/backups/pg
User=backup-runner
Group=backup-runner
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Hardening básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/backups/pg
TimeoutStartSec=2h
